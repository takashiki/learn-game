config_version=5

[application]

config/name="观察者（暂名）"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5")

[autoload]

InputSetup="*res://scripts/input_setup.gd"
Data="*res://scripts/data.gd"
