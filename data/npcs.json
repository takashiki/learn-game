[
  {
    "id": "aru",
    "name": "阿茹",
    "stranger": "磨麦的老妇人",
    "summary": "聚落里最年长的女人，认得河谷里每一种能吃的草。",
    "schedule": ["village", "village", "village", "village"],
    "idle": "阿茹朝你点了点头，继续推她的石臼。",
    "dialogues": [
      {
        "id": "aru_meet",
        "lines": [
          {"who": "", "text": "一位老妇人跪在石臼前磨着什么。她抬头打量你，手没有停。"},
          {"who": "老妇人", "text": "你不是下游的人。你身上的皮子没有缝线。"},
          {"who": "你", "text": "我从山那边来，只是看看。"},
          {"who": "阿茹", "text": "我叫阿茹。看可以。别踩屋边那块翻过的地。"}
        ]
      },
      {
        "id": "aru_grind",
        "requires": ["aru_meet"],
        "lines": [
          {"who": "阿茹", "text": "磨细了，孩子和没牙的才咽得下。"},
          {"who": "", "text": "她张开嘴给你看。剩下的几颗牙，咬面磨得像河滩上的卵石一样平。"},
          {"who": "阿茹", "text": "石头的粉也一起吃下去了。吃麦的人都这样。"}
        ]
      },
      {
        "id": "aru_seed",
        "seasons": [2],
        "requires": ["aru_meet", "village_sowing"],
        "lines": [
          {"who": "你", "text": "为什么把麦粒撒在这里？坡上不是有很多吗。"},
          {"who": "阿茹", "text": "我母亲那时候，麦子只长在坡上。有一年，倒掉的陈麦在垃圾堆边自己长出来了，比坡上的近得多。"},
          {"who": "阿茹", "text": "从那以后我每年都撒一些。"},
          {"who": "你", "text": "你挑哪些来撒？"},
          {"who": "阿茹", "text": "不挑。坑里剩什么就撒什么。"}
        ]
      },
      {
        "id": "aru_stay",
        "seasons": [2, 3],
        "requires": ["aru_meet"],
        "lines": [
          {"who": "你", "text": "你们一直住在这里吗？"},
          {"who": "阿茹", "text": "我祖母那一辈，天冷了就往下游走，天热了再回来。"},
          {"who": "阿茹", "text": "现在坑里的橡子和麦子够吃到河水上涨。谁还愿意丢下石臼走那么远？"},
          {"who": "", "text": "她拍了拍身下的石臼。它是在一整块岩石上凿出来的，根本搬不走。"}
        ],
        "teaches": {
          "id": "aru_stay",
          "title": "不再搬走的人",
          "text": "阿茹说，她祖母那一辈还随季节迁移。现在储物坑里的橡子和麦子够吃过冬天，就没有人愿意离开了。"
        }
      }
    ]
  },
  {
    "id": "tak",
    "name": "塔克",
    "stranger": "带狗的猎人",
    "summary": "聚落里最好的猎人，身边总跟着一只狗。",
    "schedule": ["marsh", "village", "marsh", "village"],
    "idle": "塔克在修他的投矛，没有抬头。",
    "dialogues": [
      {
        "id": "tak_meet",
        "lines": [
          {"who": "", "text": "一个年轻男人在检查投矛的矛尖，一只狗卧在他脚边。狗比他先发现你，低吼起来。"},
          {"who": "猎人", "text": "别动。让它闻一闻。"},
          {"who": "", "text": "狗绕着你转了一圈，回到他脚边卧下了。"},
          {"who": "塔克", "text": "它不叫了，那你可以待着。我是塔克。"}
        ]
      },
      {
        "id": "tak_dog",
        "requires": ["tak_meet"],
        "lines": [
          {"who": "塔克", "text": "它闻得到我看不见的东西。打中的羚钻进苇子里，是它找出来的。"},
          {"who": "你", "text": "它一直跟着你？"},
          {"who": "塔克", "text": "它母亲跟着我父亲。它是在我屋里生的。"}
        ]
      },
      {
        "id": "tak_fawn",
        "requires": ["tak_meet", "village_bones"],
        "lines": [
          {"who": "你", "text": "你们吃这么多跃羚，没想过抓小的回来养吗？"},
          {"who": "塔克", "text": "抓过。它整夜往墙上撞，什么都不吃，三天就死了。"},
          {"who": "塔克", "text": "羚是用来追的，不是用来关的。"}
        ]
      }
    ]
  },
  {
    "id": "nu",
    "name": "努",
    "stranger": "盯着你看的小女孩",
    "summary": "阿茹的孙女，什么都想问。",
    "schedule": ["village", "slope", "oak", "village"],
    "idle": "努冲你挥了挥手，又跑开了。",
    "dialogues": [
      {
        "id": "nu_meet",
        "lines": [
          {"who": "", "text": "一个小女孩隔着几步远盯着你手里的扫描仪。"},
          {"who": "小女孩", "text": "那块石头为什么会亮？"},
          {"who": "你", "text": "它帮我记住看到的东西。"},
          {"who": "努", "text": "我不用石头也记得住。我叫努。你叫什么？"}
        ]
      },
      {
        "id": "nu_kid",
        "seasons": [1, 2],
        "requires": ["nu_meet"],
        "lines": [
          {"who": "", "text": "努的脚边跟着一只还没断奶的小岩角羊，腿细得像芦秆。"},
          {"who": "努", "text": "塔克在崖上打了它的母亲。它自己跟着我们走回来的。"},
          {"who": "努", "text": "塔克说等它长肥了就吃掉。我不想。"}
        ]
      },
      {
        "id": "nu_winter",
        "seasons": [3],
        "requires": ["nu_kid"],
        "lines": [
          {"who": "", "text": "那只小羊长大了一圈，头上冒出了两个角芽。努走到哪里，它就跟到哪里。"},
          {"who": "努", "text": "它以为我是它的头羊。"},
          {"who": "努", "text": "塔克还是说要吃。阿茹说，再等等看。"}
        ]
      }
    ]
  }
]
